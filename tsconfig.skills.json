{
  "compilerOptions": {
    "outDir": "dist",
    "module": "commonjs",
    "target": "ES6",
    "lib": ["ES2020", "DOM"],
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "declaration": false,
    "noEmitOnError": false
  },
  "include": [
    "src/skills/**/*.ts",
    "src/browser/**/*.ts",
    "src/common/**/*.ts",
    "src/db/**/*.ts"
  ]
}
